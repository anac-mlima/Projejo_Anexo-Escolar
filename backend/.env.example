# Copie este arquivo para ".env" e preencha.
PORT=3001

# Endereços do front-end autorizados a chamar a API (separe por vírgula)
CORS_ORIGINS=http://localhost:5173

# Chave de conta de serviço baixada no console do Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Nome do bucket do Storage (aparece na aba Storage do console).
# Projetos novos: SEU-PROJETO.firebasestorage.app | projetos antigos: SEU-PROJETO.appspot.com
FIREBASE_STORAGE_BUCKET=SEU-PROJETO.firebasestorage.app
