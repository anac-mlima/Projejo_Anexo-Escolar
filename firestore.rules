rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }

    function perfilDoUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Logado + existe em /usuarios + "ativo" diferente de false
    function usuarioAtivo() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfilDoUsuario().get('ativo', true) != false;
    }

    function ehGeral() {
      return usuarioAtivo() && perfilDoUsuario().perfil == 'admin_geral';
    }

    function ehSecretario() {
      return usuarioAtivo() && perfilDoUsuario().perfil == 'admin_secretario';
    }

    // ---------- Coleções ----------
    // Escritas sempre negadas ao cliente: toda gravação passa pela API Node.

    match /usuarios/{uid} {
      allow read: if usuarioAtivo() && (request.auth.uid == uid || ehGeral());
      allow write: if false;
    }

    match /turmas/{turmaId} {
      allow read: if ehGeral() || ehSecretario();
      allow write: if false;
    }

    match /alunos/{alunoId} {
      allow read: if ehGeral() || ehSecretario();
      allow write: if false;
    }

    // Chamada (presença/falta): só a API Node lê e grava, já filtrando por professor.
    match /frequencias/{id} {
      allow read, write: if false;
    }
    
    // Qualquer outra coisa: bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}